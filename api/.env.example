# development | production (production switches logs to JSON lines).
APP_ENV=development
LOG_LEVEL=INFO
# JSON array of exact browser origins. Native apps do not use browser CORS.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Full-match regex for extra origins. Default allows https://<name>.vercel.app and any
# localhost/127.0.0.1 port. Set to an empty value to disable.
# CORS_ORIGIN_REGEX=https://[a-z0-9]([a-z0-9-]*[a-z0-9])?\.vercel\.app|http://(localhost|127\.0\.0\.1)(:\d+)?

# Supabase is a migration target only. These are intentionally NOT consumed yet.
# Never ship a service-role key in a mobile app.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Export these as process environment variables for optional billing verification.
# Billing is disabled unless explicitly true and credentials/package are present.
# Complete authentication, abuse controls and lifecycle tests before public activation.
PLAY_BILLING_ENABLED=false
PLAY_PACKAGE_NAME=com.autosense.autosense_ai
# GOOGLE_APPLICATION_CREDENTIALS=D:/private/google-play-service-account.json
